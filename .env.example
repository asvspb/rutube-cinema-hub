# ===========================================
# Rutube Cinema Hub - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# ===========================================
# Server Configuration
# ===========================================
PORT=9230
NODE_ENV=development

# ===========================================
# Database Configuration
# ===========================================
# SQLite (local development)
DATABASE_URL="file:./dev.db"

# PostgreSQL (production - uncomment to use)
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Database provider: sqlite or postgresql (default: sqlite)
# DATABASE_PROVIDER=sqlite

# ===========================================
# Authentication / JWT
# ===========================================
# Secret keys for JWT signing (use secure random strings in production!)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secure-random-string-at-least-32-characters
JWT_REFRESH_SECRET=another-secure-random-string-at-least-32-characters

# Token expiration times
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# JWT issuer identifier
JWT_ISSUER=rutube-cinema-hub

# Session lifetime in days
SESSION_TTL_DAYS=30

# Password hashing rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# ===========================================
# Proxy Configuration
# ===========================================
PROXY_MAX_REDIRECTS=5
PROXY_TIMEOUT_MS=30000
PROXY_CONNECT_TIMEOUT_MS=30000
PROXY_REQUEST_TIMEOUT_MS=60000
PROXY_RATE_LIMIT_MAX_REQUESTS=1000
PROXY_RATE_LIMIT_WINDOW_MS=60000

# ===========================================
# LLM Configuration (AI Features)
# ===========================================
# Provider priority: gemini, mistral, or auto (default: auto)
LLM_PROVIDER=auto

# Timeout for LLM requests (seconds)
LLM_TIMEOUT_SEC=30

# Maximum tokens for LLM responses
LLM_MAX_TOKENS=512

# ===========================================
# Gemini API (Google AI)
# ===========================================
GEMINI_ENABLED=true
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-flash

# ===========================================
# Mistral API
# ===========================================
MISTRAL_ENABLED=true
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL_NAME=mistral-medium-2505
MISTRAL_API_BASE_URL=https://api.mistral.ai/v1

# ===========================================
# Logging
# ===========================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=debug