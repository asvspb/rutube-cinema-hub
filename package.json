{
  "name": "kino-club",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "dev:all": "bash scripts/dev-all-in-one.sh",
    "docker:rebuild": "bash scripts/docker-rebuild-quick.sh",
    "docker:rebuild:full": "bash scripts/docker-rebuild-full.sh",
    "docker:clean": "docker-compose down -v && docker builder prune -f",
    "docker:logs": "docker-compose logs -f",
    "docker:ps": "docker-compose ps",
    "test": "npm run test:api && npm run test:frontend",
    "test:proxy": "bash scripts/test-proxy.sh",
    "test:api": "node --test tests/*.test.js tests/backend/*.test.js",
    "test:frontend": "vitest run",
    "test:frontend:watch": "vitest",
    "test:frontend:coverage": "vitest run --coverage",
    "test:security": "node tests/test-validation-functions.js",
    "test:migration": "bash scripts/test-after-migration.sh",
    "monitor:logs": "bash scripts/monitor-error-logs.sh",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze-bundle": "ANALYZE_BUNDLE=true npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^1.39.0",
    "@prisma/adapter-libsql": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "axios": "^1.13.4",
    "bcryptjs": "^3.0.3",
    "buffer": "^6.0.3",
    "cheerio": "^1.2.0",
    "clsx": "2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "11.0.24",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.344.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.3",
    "supertest": "^7.2.2",
    "tailwind-merge": "2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^2.13.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "happy-dom": "^20.6.1",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "prisma": "^7.4.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
